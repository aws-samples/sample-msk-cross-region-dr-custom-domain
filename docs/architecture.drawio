        <mxCell id="Gy-fz9b7PheaUD5NWjpo-3" parent="Gy-fz9b7PheaUD5NWjpo-2" style="text;html=1;align=center;verticalAlign=middle;fontSize=11;fontColor=#232F3E;" value="Amazon Route 53 — Private Hosted Zone&#xa;bootstrap.&lt;domain&gt; FAILOVER record&#xa;(associated with all 3 VPCs, both Regions)&#xa;PRIMARY record health check = RECOVERY_CONTROL (ARC)" vertex="1">
          <mxGeometry height="56" width="380" x="550" y="106" as="geometry" />
        </mxCell>
        <mxCell id="dr-legend" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F2F8FD;strokeColor=#147EBA;fontColor=#232F3E;align=left;verticalAlign=top;fontSize=12;spacingLeft=10;spacingTop=6;spacingRight=10;arcSize=4;" value="&lt;b style=&quot;font-size:14px&quot;&gt;Data flow (numbered on arrows)&lt;/b&gt;&#xa;&#xa;&lt;b&gt;Steady state&lt;/b&gt;&#xa;&lt;b&gt;1&lt;/b&gt;  DNS resolves bootstrap.&amp;lt;domain&amp;gt; → PRIMARY NLB&#xa;&lt;b&gt;2&lt;/b&gt;  client bootstraps through the NLB&#xa;&lt;b&gt;3&lt;/b&gt;  client connects DIRECT to primary brokers (TGW)&#xa;&#xa;&lt;b&gt;Failover — 3 levers&lt;/b&gt;&#xa;&lt;b&gt;C&lt;/b&gt;  ARC routing control primary → Off (operator flip)&#xa;&#xa;&#xa;&lt;b&gt;4&lt;/b&gt;  RECOVERY_CONTROL health check unhealthy → DNS → DR NLB&#xa;&#xa;&#xa;also: stateless NACL DENY tcp/9098 + SG revoke on&#xa;primary subnets cut IN-FLIGHT + new broker sessions&#xa;&#xa;&lt;b&gt;5&lt;/b&gt;  client re-bootstraps DIRECT to DR brokers&#xa;&#xa;&lt;b&gt;R&lt;/b&gt;  Replicator syncs topics (IDENTICAL names)" vertex="1">
          <mxGeometry height="330" width="380" x="1640" y="70" as="geometry" />
        </mxCell>
