{
  "app": "python3 app.py",
  "watch": {
    "include": ["**"],
    "exclude": [
      "README.md",
      "cdk*.json",
      "requirements*.txt",
      "**/__pycache__",
      "**/*.pyc",
      "tests"
    ]
  },
  "context": {
    "domain_name": "example.internal",
    "cluster_name": "msk-xregion-dr-demo",
    "primary_region": "us-east-1",
    "dr_region": "us-west-2",
    "@aws-cdk/aws-lambda:recognizeLayerVersion": true,
    "@aws-cdk/core:checkSecretUsage": true,
    "@aws-cdk/core:target-partitions": ["aws"]
  }
}
